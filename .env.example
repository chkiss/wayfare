# Copy to .env (gitignored) or set these in the systemd unit.
# No real value belongs in this file — it is committed.

# How much calendar access to ask for.
#   full — the sensitive calendar scope. Events land on your own calendar and
#          the duplicate check can see bookings already there. Google shows an
#          unverified-app warning at consent.
#   app  — calendar.app.created. No warning, but the app may only touch
#          calendars it created: travel appears on its own calendar, and it
#          cannot see anything already on yours.
WAYFARE_SCOPE_MODE=full

# Where the finished events go in "full" mode. "primary" is your main calendar.
WAYFARE_CALENDAR_ID=primary
# Where they go in "app" mode, created by the app on first use.
WAYFARE_TARGET_CALENDAR=Travel
WAYFARE_PENDING_CALENDAR=Travel (pending)

# Promotion policy.
WAYFARE_AUTO_PROMOTE=true
WAYFARE_PROMOTE_THRESHOLD=0.85

# Model backend: any OpenAI-compatible endpoint.
# Free vision-free text models are plenty here — the model never sees an image.
WAYFARE_LLM_BASE_URL=https://openrouter.ai/api/v1
WAYFARE_LLM_MODEL=google/gemma-4-31b-it:free
# WAYFARE_LLM_API_KEY=   # better: write it to secrets/llm_api_key

# Optional live flight-schedule check. "none" disables it.
WAYFARE_SCHEDULE_PROVIDER=none
# WAYFARE_SCHEDULE_API_KEY=

# Paths. Defaults sit inside the repo, which is fine for local use; a deployed
# instance should point these outside it.
# WAYFARE_STATE_DIR=~/.local/state/wayfare
# WAYFARE_SECRETS_DIR=~/.config/wayfare/secrets
# WAYFARE_CONVENTIONS=~/.config/wayfare/conventions.json
