# Secrets and per-user state — NEVER commit
secrets/
*.json.secret
client_secret*.json
token*.json
.env
.env.*
!.env.example

# Runtime state: uploads, parsed itineraries, undo log
var/
data/airports.csv
data/*.cache

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Downloaded reference data — other people's datasets, fetched on demand by
# `wayfare fetch-airports` and `wayfare fetch-reference`. OurAirports is public
# domain, OpenTravelData is CC-BY, and Trainline's stations are ODbL, which
# puts obligations on redistribution. Committing them would make this repo a
# copy of somebody else's data rather than a program that reads it.
data/
